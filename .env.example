# DashClaw Environment Variables
# Copy this file to .env.local and fill in your values

# ─── REQUIRED ──────────────────────────────────────────────────────────────────
# These must be set for DashClaw to start.

# PostgreSQL connection string
# Local: docker compose up -d db → postgresql://dashclaw:dashclaw@localhost:5432/dashclaw
# Hosted: Neon free tier → https://neon.tech
DATABASE_URL=<YOUR_DATABASE_URL>

# API key that protects /api/* endpoints (maps to org_default)
DASHCLAW_API_KEY=<YOUR_SECRET_API_KEY>

# 32-character string used to encrypt sensitive settings
ENCRYPTION_KEY=<random-32-char-string-here>

# NextAuth base URL and signing secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<random-32-char-secret>

# ─── RECOMMENDED ───────────────────────────────────────────────────────────────

# Password for the local admin account (skip OAuth for solo/self-hosted use)
# DASHCLAW_LOCAL_ADMIN_PASSWORD=<your-strong-password>

# Cron endpoint secret (generate: openssl rand -hex 32)
# CRON_SECRET=<random-64-char-hex>

# ─── OPTIONAL: Deployment ──────────────────────────────────────────────────────

# self_host (default) | demo (read-only sandbox for dashclaw.io)
# DASHCLAW_MODE=self_host
# NEXT_PUBLIC_DASHCLAW_MODE=self_host

# Force DB driver: "postgres" (TCP) or "neon" (serverless). Auto-detected by default.
# DASHCLAW_DB_DRIVER=postgres

# Override which org DASHCLAW_API_KEY maps to (default: org_default)
# DASHCLAW_API_KEY_ORG=org_default

# Restrict CORS to your deployment domain
# ALLOWED_ORIGIN=https://your-app.vercel.app

# Self-host on TCP Postgres only: where the middleware reaches its own internal
# key-resolution route. Defaults to loopback on PORT; set explicitly when the
# server binds a nonstandard address. Never a third-party host.
# DASHCLAW_INTERNAL_BASE_URL=http://127.0.0.1:3000

# Trust x-forwarded-for from a reverse proxy for rate limiting
# TRUST_PROXY=false

# Change the HTTP port (default: 3000)
# PORT=3000

# ─── OPTIONAL: Rate Limiting ───────────────────────────────────────────────────

# Distributed rate limiting via Upstash Redis (recommended for multi-instance)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# Per-IP rate limit tuning (in-memory, single-instance)
# DASHCLAW_DISABLE_RATE_LIMIT=true
# DASHCLAW_RATE_LIMIT_WINDOW_MS=60000
# DASHCLAW_RATE_LIMIT_MAX=1000

# SSRF protection — comma-separated trusted webhook domains
# WEBHOOK_ALLOWED_DOMAINS=slack.com,discord.com

# ─── OPTIONAL: Phase 2 JWT identity verification (JWKS) ─────────────────────────
# When an agent attaches `Authorization: Bearer <JWT>`, DashClaw verifies it
# against the issuer's JWKS ({iss}/.well-known/jwks.json) and a verified token's
# `sub` overrides the self-asserted body agent_id across /api/guard, /api/actions,
# and /api/x402/purchases. No token → identity stays self-asserted (unverified).
#
# Restrict which issuers are trusted (recommended in production — without it any
# issuer with a reachable JWKS is accepted). Tokens from other issuers → unknown_issuer.
# DASHCLAW_ALLOWED_ISSUER=https://your-idp.example.com
#
# Require this value in the JWT `aud` claim (tokens missing it → failed).
# DASHCLAW_JWT_AUDIENCE=dashclaw

# ─── OPTIONAL: Phase 2b JWT replay protection ──────────────────────────────────
# Closes the capture-and-replay gap left by Phase 2 (signature-only verification).
# Design by @piiiico in issue #120. Only effective when the JWT carries a `jti`
# claim AND verifyJwt returned `verified` (signature OK + not expired + not nbf).
#
# off          — skip the replay check entirely (or you run replay protection upstream)
# best_effort  — default — block confirmed replays; allow if jti is missing
#                or the store is unreachable (Phase 2 fail-soft posture)
# required     — also block when the store is unreachable or jti is missing
# DASHCLAW_JTI_REPLAY_PROTECTION=best_effort
#
# Reject JWTs whose exp is more than this many seconds in the future. Tokens
# with very long lifetimes defeat the replay seen-set (it grows unbounded).
# Default 86400 (24h). Allow ±60s skew on the cap.
# DASHCLAW_JTI_MAX_TTL_SECONDS=86400

# ─── OPTIONAL: Phase 2c action binding (issue #121) ────────────────────────────
# Binds a verified token to ONE intended (action, target, goal) tuple via a
# `urn:dashclaw:act-binding` claim, so a token minted to `read` one record can't
# be repurposed to `delete` a different one. Needs issuer cooperation (the IdP
# must mint the claim), so the default is `off`. act_status is recorded in EVERY
# mode — even `off` — so operators can see when their issuer starts minting
# bindings (look for act_status='match' in guard_decisions) and safely flip on.
#
# off          — default — record act_status, never block on it
# best_effort  — also block a positive `mismatch` (token bound to a different call)
# required     — also block not_present / unsupported_typ / ctx_incomplete on
#                verified tokens (opt in only once your issuer mints the claim)
# DASHCLAW_ACT_BINDING=off
#
# Comma-separated list of accepted binding `typ` values. Bump the version
# suffix (action-binding/v2) to invalidate old tokens cleanly.
# DASHCLAW_ACT_BINDING_TYP=action-binding/v1

# ─── OPTIONAL: Integrity signing key (non_fabrication receipts + signed export) ─
# Ed25519 private JWK used to sign proof receipts and signed compliance bundles.
# LEAVE UNSET for zero-config: the instance auto-generates a key on first use and
# stores it in the server_signing_keys table. Set this only if you want external
# key custody (the value is a JSON Ed25519 private JWK with x and d). The public
# key is published at /.well-known/jwks.json either way.
# DASHCLAW_SIGNING_KEY_JWK={"kty":"OKP","crv":"Ed25519","x":"<base64url>","d":"<base64url>"}

# ─── OPTIONAL: Realtime ────────────────────────────────────────────────────────

# memory (default, single-instance) | redis (cross-instance pub/sub)
# REALTIME_BACKEND=memory
# REDIS_URL=redis://localhost:6379
# REALTIME_REPLAY_WINDOW_SECONDS=600
# REALTIME_REPLAY_MAX_EVENTS=1000
# REALTIME_ENFORCE_REDIS=false

# ─── OPTIONAL: OAuth Providers ─────────────────────────────────────────────────

# GitHub OAuth — https://github.com/settings/developers
# GITHUB_ID=<your-github-oauth-app-client-id>
# GITHUB_SECRET=<your-github-oauth-app-client-secret>

# Google OAuth — https://console.cloud.google.com/apis/credentials
# GOOGLE_ID=<your-google-oauth-client-id>
# GOOGLE_SECRET=<your-google-oauth-client-secret>

# OIDC Provider (e.g. Authentik, Keycloak)
# OIDC_ISSUER_URL=<your-oidc-issuer-url>
# OIDC_CLIENT_ID=<your-oidc-client-id>
# OIDC_CLIENT_SECRET=<your-oidc-client-secret>
# OIDC_DISPLAY_NAME=Authentik
# Explicit endpoint overrides — required for Authentik; set all three together:
# OIDC_AUTHORIZATION_URL=<your-oidc-authorization-endpoint>
# OIDC_TOKEN_URL=<your-oidc-token-endpoint>
# OIDC_USERINFO_URL=<your-oidc-userinfo-endpoint>

# ─── OPTIONAL: Billing ─────────────────────────────────────────────────────────

# Stripe — https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=<your-stripe-secret-key>
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>
# STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>
# STRIPE_PRICE_PRO=<price_xxx>
# STRIPE_PRICE_BUSINESS=<price_xxx>
# Public base URL for Stripe checkout/portal redirects (defaults to http://localhost:3000 if unset)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── OPTIONAL: Alerts ──────────────────────────────────────────────────────────

# Resend email alerts — https://resend.com
# RESEND_API_KEY=<your-resend-api-key>
# ALERT_FROM_EMAIL=alerts@example.com

# ─── OPTIONAL: Analytics ───────────────────────────────────────────────────────

# Vercel Web Analytics (auto-enabled on Vercel; opt-in elsewhere)
# NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=true

# ─── OPTIONAL: Agent Security ──────────────────────────────────────────────────

# Require signed agent actions (true by default in production)
# ENFORCE_AGENT_SIGNATURES=true

# Require agents to be pre-registered before submitting actions
# DASHCLAW_CLOSED_ENROLLMENT=false

# Minutes before an agent pairing request expires (default 15). Raise this for
# admin enrollment flows where the approver isn't standing by to approve.
# DASHCLAW_PAIRING_TTL_MINUTES=15

# Prompt-injection scanning runs on every guard evaluation by default.
# Set to true to disable it (security-relevant — leave unset to keep scanning on).
# DISABLE_PROMPT_INJECTION_SCAN=true

# ─── OPTIONAL: Claude Code Hook + SDK clients ─────────────────────────────────
# Used by hooks/dashclaw_pretool.py, hooks/dashclaw_posttool.py,
# hooks/dashclaw_stop.py, hooks/dashclaw_session_digest.py,
# scripts/install-hooks.mjs, examples/, and the SDK
# starter snippets. DASHCLAW_BASE_URL points at YOUR DashClaw instance —
# typically https://my-dashclaw.vercel.app or http://localhost:3000.

# DASHCLAW_BASE_URL=http://localhost:3000
# DASHCLAW_URL=http://localhost:3000          # Legacy alias — MCP server + older docs
# DASHCLAW_AGENT_ID=claude-code
# DASHCLAW_HOOK_MODE=enforce                  # enforce | observe
# DASHCLAW_DIGEST_DISABLED=1                  # set to disable the SessionStart memory digest hook
# DASHCLAW_PERMISSION_MODE=danger             # danger | safer (controls bash classification strictness)
# DASHCLAW_GUARD_TIMEOUT=2.5                  # seconds — guard call timeout
# DASHCLAW_GUARD_RETRIES=0                    # extra guard attempts after the first (default 0 = one attempt; set 2 for flaky networks)
# DASHCLAW_GUARD_CONNECT_TIMEOUT=2            # seconds — TCP preflight bound when the instance recently probed unreachable
# DASHCLAW_APPROVAL_TIMEOUT=30                # seconds — Stop hook approval poll timeout
# Controls hook behavior when /api/guard is unreachable (network failure, instance down).
# Values: block (default, fail closed — destructive actions blocked during outage),
#         warn  (proceed with a loud stderr warning — actions logged for backfill),
#         allow (proceed silently — not recommended, defeats the audit promise).
# All outages write to ~/.dashclaw/orphan-actions.jsonl for backfill on recovery.
# DASHCLAW_GUARD_UNAVAILABLE_POLICY=block
# DASHCLAW_GOVERNED_CATEGORIES=execution,orchestration,file_io,interactive,mcp
# DASHCLAW_WORKSPACE=/path/to/your/project    # Optional override; defaults to cwd

# ─── OPTIONAL: Claude Code Code Sessions (transcript capture) ───────────────────
# ON BY DEFAULT, metadata-only. The Stop hook ships each turn's session METADATA
# (token counts, models, timestamps, tool names/ids, safe path fields — prompt
# and file text is stripped before it leaves your machine) to
# /api/code-sessions/ingest-jsonl for cost/token/cache analytics and the
# end-of-turn recap line. View captured sessions at /code-sessions.
# Opt out entirely:
# DASHCLAW_CODE_SESSIONS_ENABLED=0
# Explicitly opt IN to shipping full transcript content (previous behavior):
# DASHCLAW_CODE_SESSIONS_CONTENT=full
#
# Capture EVERY project on your machine (not just this repo) without writing your
# API key into global config: run `node scripts/install-hooks.mjs --global`. It
# installs a capture-only Stop hook into ~/.claude/settings.json that points back
# at this repo's hooks/dashclaw_stop.py, which reads these vars from this file.

# ─── OPTIONAL: Behavior Learning / Policy Coach (passive local recorder) ────────
# Opt-in. When set, the Pre/PostToolUse hooks write REDACTED, LOCAL-ONLY behavior
# samples to .dashclaw/behavior-samples/<date>.jsonl. The Policy Coach (/policy-coach)
# analyzes them into evidence-backed policy suggestions. Observe-only — nothing is
# enforced, nothing is uploaded. Secrets/keys/env values are scrubbed before write.
# In Claude Code settings.json, set this in the "env" block as a STRING ("1");
# in this .env file, the bare KEY=1 form below is correct. Accepts 1|true|yes.
# DASHCLAW_BEHAVIOR_SAMPLES_ENABLED=1
# DASHCLAW_BEHAVIOR_SAMPLES_DIR=/path/to/.dashclaw/behavior-samples   # default: <workspace>/.dashclaw/behavior-samples
# To capture OTHER projects and view them in this instance's Policy Coach, set the
# SAME absolute DASHCLAW_BEHAVIOR_SAMPLES_DIR in BOTH the hook env (settings.json)
# and this server .env.local — otherwise samples land in each project's local
# .dashclaw/ and the UI (which reads this app's cwd) won't see them. .dashclaw/ is gitignored.
#
# "Learning in the background" on a HOSTED dashboard: a serverless instance can't
# read your local samples, so when the recorder is on, the Stop hook pushes a
# SAFE AGGREGATE snapshot (counts/tallies/signals/timestamps — never command
# shapes, paths, or goals) to /api/behavior/insights so the hosted Policy Coach
# can show DashClaw is alive and learning. Raw behavior still never leaves the
# machine. On by default when the recorder is on; opt out with the line below.
# DASHCLAW_BEHAVIOR_INSIGHTS=0
#
# OPT-IN anonymized sample upload (default OFF — absent means off): when set on
# the agent machine, the Stop hook uploads ANONYMIZED samples (goals/projects/
# agent names dropped; session + paths replaced with salted hashes; command
# operands masked) to /api/behavior/samples/ingest so a HOSTED Policy Coach can
# run the full suggestions → simulate → adopt flow. The salt derives from your
# API key and never leaves the machine.
# DASHCLAW_BEHAVIOR_UPLOAD=1

# ─── OPTIONAL: Semantic Guard (required for semantic_check policies) ────────────
# Without a key, semantic_check policies fall back to require_approval (safe middle path).
# Set GUARD_LLM_KEY to a dedicated key (preferred), or OPENAI_API_KEY / ANTHROPIC_API_KEY as fallbacks.
# GUARD_LLM_KEY=sk-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=...                # also enables Google as an LLM-as-judge provider for eval scorers
# GUARD_LLM_BASE_URL=https://api.openai.com/v1
# GUARD_LLM_MODEL=gpt-4o-mini

# ─── OPTIONAL: Guard degradation contract ───────────────────────────────────────
# What the guard returns when it cannot complete an evaluation (webhook
# timeout/failure, semantic LLM failure, evaluation deadline exceeded).
# Default: require_approval (fail closed). Per-policy rules (on_timeout,
# fallback) override this global. "allow" restores the old fail-open behavior
# (self-hoster escape hatch); "block" is the strictest posture.
# DASHCLAW_GUARD_FALLBACK=require_approval
# Policy-evaluation deadline in ms (default 3500). The hooks give the whole
# guard HTTP call 5s with zero retries — keep this safely under that budget.
# DASHCLAW_GUARD_DEADLINE_MS=3500
# Client-side (hooks + MCP server, not this server): what governed clients do
# when this instance is UNREACHABLE. Default block (fail closed); allow = the
# self-hoster escape hatch. Full contract: docs/guard-enforcement-contract.md
# DASHCLAW_GUARD_UNAVAILABLE_POLICY=block

# ─── OPTIONAL: Tuning knobs ────────────────────────────────────────────────────
# DASHCLAW_DB_POOL_MAX=10            # Postgres pool max connections (default 10)
# AGENT_ONLINE_WINDOW_MS=120000      # ms an agent counts as "online" since last heartbeat (default 120000)
# GUARD_WEBHOOK_SECRET=<random>      # HMAC secret for outbound guard webhook signing
# DASHCLAW_INTERRUPT_BUDGET=10        # org setting (settings table) — approval interrupts per policy per window before flood collapse
# DASHCLAW_INTERRUPT_WINDOW_MIN=15    # flood window in minutes
# DASHCLAW_INTERRUPT_BUDGET_FLEET=30  # fleet-wide interrupt budget per window
# DASHCLAW_DIGEST_INTERVAL_HOURS=24   # fleet digest cadence (0 disables); needs notification adapter creds

# ─── OPTIONAL: Telegram approval bridge ────────────────────────────────────────
# Feature is off when TELEGRAM_BOT_TOKEN is unset. Run `npm run telegram:setup` to populate.
# TELEGRAM_BOT_TOKEN=                 # from @BotFather
# TELEGRAM_ADMIN_CHAT_ID=             # numeric chat ID allowed to approve
# TELEGRAM_WEBHOOK_SECRET=            # 32+ random chars; verifies inbound callbacks (openssl rand -hex 32)
# TELEGRAM_APPROVER_ORG_ID=           # org id — auto-discovered via DASHCLAW_API_KEY in `npm run telegram:setup`
# DASHCLAW_ALERTS_TELEGRAM=false      # explicit kill-switch when token is present

# ─── OPTIONAL: Discord approval bridge ─────────────────────────────────────────
# Feature is off when DISCORD_BOT_TOKEN is unset. Registration is a Developer Portal UI step.
# DISCORD_BOT_TOKEN=                  # from Discord Developer Portal -> Bot -> Reset Token
# DISCORD_PUBLIC_KEY=                 # 64-char hex from Developer Portal -> General Information
# DISCORD_APPROVER_USER_ID=           # numeric Discord user ID allowed to approve
# DISCORD_APPROVER_ORG_ID=            # org id — same value as TELEGRAM_APPROVER_ORG_ID in single-admin setups
# DASHCLAW_ALERTS_DISCORD=false       # explicit kill-switch when token is present

# Optional: Discord webhook URL for launch-window new-connect alerts (DOG-04 telemetry).
# Fires once per org on its first /connect completion. Payload is masked
# org_id + agent_id + timestamp — no secrets, no PII. Distinct from
# DASHCLAW_ALERTS_DISCORD (which is the bridge kill-switch, not a URL).
# DASHCLAW_NEW_CONNECT_WEBHOOK=

# ─── OPTIONAL: Hosted provisioning (operator-only, self-host deploys leave OFF) ──
# When DASHCLAW_HOSTED=true the deployment exposes /api/hosted/* routes that
# mint trial workspaces on demand. Self-host users should leave this unset —
# they create orgs via /api/orgs with their own admin API key.
# DASHCLAW_HOSTED=false
# TURNSTILE_SECRET_KEY=                       # Cloudflare Turnstile secret; unset = dev bypass
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=             # Client-side Turnstile widget site key (pairs with TURNSTILE_SECRET_KEY)
# HOSTED_TRIAL_DAYS=30                        # Trial duration in days
# HOSTED_TRIAL_ACTION_CAP=10000               # Max governed actions per trial
# HOSTED_MAX_ACTIVE_TRIALS=500                # Global cap on concurrent active trials (cost circuit breaker); default 500 (0/blank -> 500)
# HOSTED_PROVISION_MAX_PER_IP_PER_DAY=5       # Per-IP provisioning rate limit (rolling day)
# HOSTED_CLEANUP_SECRET=                      # Shared secret for cron-invoked /api/hosted/cleanup (X-Cleanup-Secret header)
# CRON_SECRET=                                # Vercel cron auth (Authorization: Bearer); pairs with /api/hosted/cleanup
# HOSTED_SMOKE_BASE_URL=                      # Default URL for `npm run hosted:smoke`
