#!/bin/sh
# living-merge: re-derive generated projections after a TRUE (3-way) merge, so
# the working tree is self-consistent with the merged source. The
# merge=regenerate driver kept generated files conflict-free; this overwrites
# them with a correct regeneration.
#
# NOTE: fast-forward merges and fast-forward `git pull` do NOT create a merge
# commit and do NOT fire post-merge. Landing goes through
# scripts/living-merge/rebase-onto-main.ts (which regenerates explicitly), and a
# FF pull of an already-consistent main needs no regeneration.
#
# Logic lives in a cross-platform Node script (no bash-isms). It FAILS LOUD: a
# non-zero exit does not undo the merge, but it surfaces a broken regeneration
# so a stale-projection working tree never passes silently.
node scripts/living-merge/regenerate-all.mjs --quiet
