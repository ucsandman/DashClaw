{
  "name": "dashclaw-platform",
  "version": "5.11.1",
  "description": "Decision infrastructure for AI agents — governance runtime with policy enforcement, decision recording, and human-in-the-loop approval.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ucsandman/DashClaw.git"
  },
  "author": "DashClaw",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "demo": "node scripts/run-demo.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/validate-docs.mjs",
    "doctor": "node --import tsx scripts/doctor.mjs",
    "db:migrate": "node scripts/auto-migrate.mjs",
    "liveness:probe": "python hooks/enforcement_liveness_probe.py",
    "release:check": "node scripts/check-production-ready.mjs",
    "production:check": "node scripts/check-production-ready.mjs",
    "hosted:check-ready": "node scripts/check-hosted-ready.mjs",
    "hosted:smoke": "node scripts/smoke-hosted.mjs",
    "drill:fresh-windows": "node scripts/drills/fresh-windows.mjs",
    "drill:fresh-linux": "node scripts/drills/fresh-linux.mjs",
    "drill:hosted": "node scripts/drills/hosted-stranger.mjs",
    "bundles:refresh": "node scripts/refresh-bundles.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/check-openapi-diff.mjs",
    "api:inventory:generate": "node scripts/generate-api-inventory.mjs",
    "api:inventory:check": "node scripts/check-api-inventory-diff.mjs",
    "route-sql:baseline:generate": "node scripts/generate-route-sql-baseline.mjs",
    "route-sql:check": "node scripts/check-route-sql-guard.mjs",
    "surface:check": "node scripts/check-surface-budget.mjs",
    "version:check": "node scripts/check-version-hardcodes.mjs",
    "version:sync:check": "node scripts/check-version-sync.mjs",
    "version:set": "node scripts/set-version.mjs",
    "sdk:count": "node scripts/count-sdk-methods.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:diagnose": "node scripts/diagnose-hooks.mjs",
    "telegram:setup": "node scripts/telegram-setup-wizard.mjs",
    "telegram:register": "node scripts/telegram-register-webhook.mjs",
    "telegram:verify": "node scripts/telegram-verify-loop.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "guide:drift:check": "node scripts/check-platform-guide-drift.mjs",
    "guide:examples:regen": "node scripts/regen-platform-guide-examples.mjs",
    "contracts:check:warn": "node scripts/check-contracts.mjs --mode=warn",
    "sdk:integration": "node scripts/check-sdk-cross-integration.mjs",
    "sdk:integration:python": "node scripts/run-python-unittest.mjs",
    "hooks:test:python": "node scripts/run-python-unittest.mjs",
    "sdk:live": "node scripts/_run-with-env.mjs scripts/test-sdk-live.mjs",
    "sdk:live:python": "node scripts/_run-with-env.mjs scripts/run-sdk-live-python.mjs",
    "startup:smoke": "node scripts/startup-smoke.mjs",
    "guard:load": "node scripts/guard-load.mjs",
    "scripts:check-syntax": "node scripts/check-scripts-syntax.mjs",
    "setup": "node --import tsx scripts/setup.mjs",
    "init:self-host-env": "node --import tsx scripts/init-self-host-env.mjs",
    "test": "vitest",
    "test:api": "node scripts/test-full-api.mjs",
    "test:fuzz": "node scripts/fuzz-api.mjs",
    "test:smoke": "playwright test",
    "dev:smoke": "next dev -p 3099",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "calibration:mine": "node --import tsx scripts/mine-calibration-candidates.mjs",
    "calibration:add": "node --import tsx scripts/add-calibration-vector.mjs",
    "release:sdks": "node scripts/release-sdks.mjs",
    "release:mcp": "node scripts/release-mcp-server.mjs",
    "pre-commit": "node scripts/run-pre-commit-checks.mjs",
    "prepare": "node -e \"const f='scripts/living-merge/prepare.mjs';require('fs').existsSync(f)&&require('child_process').spawnSync(process.execPath,[f],{stdio:'inherit'})\"",
    "living-merge:install": "node --import tsx scripts/living-merge/install.ts",
    "living-merge:check": "node --import tsx scripts/living-merge/install.ts --check"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "2.0.1",
    "d3-force": "^3.0.0",
    "dashclaw": "^5.6.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "fflate": "^0.8.3",
    "html2pdf.js": "^0.14.0",
    "js-yaml": "^5.2.2",
    "lucide-react": "0.577.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "openai": "^7.1.0",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "react-grid-layout": "^2.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "redis": "^4.7.1",
    "resend": "^6.18.1",
    "stripe": "^22.3.2",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "sharp": "^0.35.0",
    "vite": "^8.0.16",
    "dompurify": "^3.4.11",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "acorn": "^8.18.0",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
