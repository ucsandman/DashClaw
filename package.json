{
  "name": "dashclaw-platform",
  "version": "4.4.1",
  "description": "Decision infrastructure for AI agents — governance runtime with policy enforcement, decision recording, and human-in-the-loop approval.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ucsandman/DashClaw.git"
  },
  "author": "DashClaw",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "demo": "node scripts/run-demo.mjs",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/validate-docs.mjs",
    "doctor": "node --import tsx scripts/doctor.mjs",
    "db:migrate": "node scripts/auto-migrate.mjs",
    "hosted:check-ready": "node scripts/check-hosted-ready.mjs",
    "hosted:smoke": "node scripts/smoke-hosted.mjs",
    "livingcode:refresh": "node scripts/livingcode-refresh.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/check-openapi-diff.mjs",
    "api:inventory:generate": "node scripts/generate-api-inventory.mjs",
    "api:inventory:check": "node scripts/check-api-inventory-diff.mjs",
    "route-sql:baseline:generate": "node scripts/generate-route-sql-baseline.mjs",
    "route-sql:check": "node scripts/check-route-sql-guard.mjs",
    "version:check": "node scripts/check-version-hardcodes.mjs",
    "version:sync:check": "node scripts/check-version-sync.mjs",
    "version:set": "node scripts/set-version.mjs",
    "sdk:count": "node scripts/count-sdk-methods.mjs",
    "pricing:refresh": "node scripts/refresh-model-pricing.mjs",
    "pricing:refresh:apply": "node scripts/refresh-model-pricing.mjs --apply",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:diagnose": "node scripts/diagnose-hooks.mjs",
    "diagnose:cost": "node scripts/diagnose-cost-attribution.mjs",
    "backfill:null-model-cost": "node scripts/backfill-null-model-cost.mjs",
    "telegram:setup": "node scripts/telegram-setup-wizard.mjs",
    "telegram:register": "node scripts/telegram-register-webhook.mjs",
    "telegram:verify": "node scripts/telegram-verify-loop.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "contracts:check:warn": "node scripts/check-contracts.mjs --mode=warn",
    "sdk:integration": "node scripts/check-sdk-cross-integration.mjs",
    "sdk:integration:python": "node scripts/run-python-unittest.mjs",
    "sdk:live": "node scripts/_run-with-env.mjs scripts/test-sdk-live.mjs",
    "sdk:live:python": "node scripts/_run-with-env.mjs scripts/run-sdk-live-python.mjs",
    "startup:smoke": "node scripts/startup-smoke.mjs",
    "reliability:evidence": "node scripts/collect-platform-convergence-evidence.mjs",
    "reliability:ws1:check": "node scripts/check-convergence-ws1-latency.mjs",
    "scripts:check-syntax": "node scripts/check-scripts-syntax.mjs",
    "setup": "node --import tsx scripts/setup.mjs",
    "init:self-host-env": "node --import tsx scripts/init-self-host-env.mjs",
    "seed:branch-finish": "node scripts/_run-with-env.mjs scripts/seed-branch-finish-loop.mjs",
    "branch-finish": "node scripts/_run-with-env.mjs scripts/branch-finish.mjs",
    "test": "vitest",
    "test:api": "node scripts/test-full-api.mjs",
    "test:fuzz": "node scripts/fuzz-api.mjs",
    "test:smoke": "playwright test",
    "dev:smoke": "next dev -p 3099",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "migrate:behavioral": "node scripts/migrate-behavioral-ai.mjs",
    "migrate:learning-loop": "node scripts/_run-with-env.mjs scripts/migrate-learning-loop-mvp.mjs",
    "backfill:learning-episodes": "node scripts/_run-with-env.mjs scripts/backfill-learning-episodes.mjs",
    "rebuild:learning-recommendations": "node scripts/_run-with-env.mjs scripts/rebuild-learning-recommendations.mjs",
    "backfill:embeddings": "node --import tsx scripts/backfill-embeddings.mjs",
    "release:sdks": "node scripts/release-sdks.mjs",
    "traffic:poll": "node scripts/_run-with-env.mjs scripts/poll-github-traffic.mjs",
    "pre-commit": "node scripts/run-pre-commit-checks.mjs",
    "prepare": "node -e \"const f='scripts/living-merge/prepare.mjs';require('fs').existsSync(f)&&require('child_process').spawnSync(process.execPath,[f],{stdio:'inherit'})\"",
    "living-merge:install": "node --import tsx scripts/living-merge/install.ts",
    "living-merge:check": "node --import tsx scripts/living-merge/install.ts --check"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "2.0.1",
    "@xyflow/react": "^12.11.0",
    "better-sqlite3": "^12.10.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "dashclaw": "^4.2.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.0",
    "fflate": "^0.8.3",
    "html2pdf.js": "^0.14.0",
    "js-yaml": "^4.2.0",
    "lucide-react": "0.577.0",
    "next": "^16.2.7",
    "next-auth": "^4.24.14",
    "openai": "^6.42.0",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "react-grid-layout": "^2.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "redis": "^4.7.1",
    "resend": "^6.12.4",
    "stripe": "^22.2.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "dompurify": "^3.4.0",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "acorn": "^8.16.0",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
