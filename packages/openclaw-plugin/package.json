{
  "name": "@dashclaw/openclaw-plugin",
  "version": "1.2.5",
  "description": "DashClaw governance for OpenClaw — policy enforcement, human approval, and decision recording for every tool call.",
  "main": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "author": "DashClaw",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "dashclaw",
    "governance",
    "ai-safety",
    "hitl",
    "approval"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ucsandman/DashClaw.git",
    "directory": "packages/openclaw-plugin"
  },
  "homepage": "https://github.com/ucsandman/DashClaw/tree/main/packages/openclaw-plugin#readme",
  "files": [
    "src/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "hooks": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dashclaw": "^2.11.1"
  },
  "peerDependencies": {
    "openclaw": "^2026.4.15"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "axios": "^1.16.0",
    "tar": "^7.5.11",
    "protobufjs": "^7.5.5"
  }
}
