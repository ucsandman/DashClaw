{
  "name": "@dashclaw/openclaw-plugin",
  "version": "1.6.4",
  "description": "DashClaw policy checks, remote approvals, and execution claims at OpenClaw's supported tool hook boundary.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "author": "DashClaw",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "dashclaw",
    "governance",
    "ai-safety",
    "hitl",
    "approval"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ucsandman/DashClaw.git",
    "directory": "packages/openclaw-plugin"
  },
  "homepage": "https://github.com/ucsandman/DashClaw/tree/main/packages/openclaw-plugin#readme",
  "files": [
    "dist/",
    "src/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "hooks": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.4.15",
      "minGatewayVersion": "2026.4.15"
    },
    "build": {
      "openclawVersion": "2026.4.15",
      "pluginSdkVersion": "2026.4.15"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "dashclaw": "^5.0.0"
  },
  "peerDependencies": {
    "openclaw": "^2026.4.15"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "axios": "^1.16.0",
    "tar": "^7.5.22",
    "protobufjs": "^7.6.5",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "brace-expansion": "^5.0.8",
    "@hono/node-server": "^1.19.15",
    "fast-uri": "^3.1.4",
    "hono": "^4.12.34"
  }
}
