# @dashclaw/mcp-server provider credentials. Copy to `.env` and fill in the providers you use.
# These are read at call time and NEVER written to .dashclaw-local/.
# Set them in your MCP client's `env` block (preferred) or your shell.

# Optional: stale file-lock threshold for .dashclaw-local/state.json and memory.json.
# Defaults to 30000 ms. Increase if your filesystem is unusually slow.
DASHCLAW_LOCK_STALE_MS=30000

# Optional: provider API request timeout.
# Defaults to 30000 ms. Must be a positive integer.
DASHCLAW_HTTP_TIMEOUT_MS=30000

# Optional: cap retained local memory/audit entries. Unset means unlimited.
DASHCLAW_MEMORY_MAX_ENTRIES=
DASHCLAW_AUDIT_MAX_ENTRIES=

# DashClaw authoritative governance gate for risky provider actions.
# Reads can proceed without DashClaw; writes/deploys/env changes/live/destructive actions fail closed.
DASHCLAW_URL=
DASHCLAW_API_KEY=
# Optional agent identifier used to attribute governed actions.
DASHCLAW_AGENT_ID=
DASHCLAW_TIMEOUT_MS=30000
DASHCLAW_MODE=authoritative

# GitHub — fine-grained PAT (Metadata: read, Contents: read, Actions: read; add Actions: write for rerun/cancel)
GITHUB_TOKEN=

# Vercel — account/team token
VERCEL_TOKEN=
# Optional: required for team-owned resources
VERCEL_TEAM_ID=

# Supabase — personal access token
SUPABASE_ACCESS_TOKEN=

# Stripe — separate test and live secret keys (mode is determined by the key prefix)
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=

# Railway — account/workspace token
RAILWAY_TOKEN=

# Neon — API key from console.neon.tech -> Account settings -> API keys
NEON_API_KEY=neon_api_key_here

# Upstash — Developer API uses Basic auth with EMAIL:API_KEY.
UPSTASH_EMAIL=you@example.com
UPSTASH_API_KEY=upstash_api_key_here
# App envs returned by get_upstash_redis_env / create_upstash_redis_database:
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=upstash_redis_rest_token_here
# UPSTASH_REDIS_READ_ONLY_REST_TOKEN=upstash_redis_readonly_rest_token_here
# QStash background jobs / cron schedules:
QSTASH_TOKEN=qstash_token_here
# App envs returned by get_upstash_qstash_env:
# QSTASH_URL=https://qstash.upstash.io
# QSTASH_CURRENT_SIGNING_KEY=qstash_current_signing_key_here
# QSTASH_NEXT_SIGNING_KEY=qstash_next_signing_key_here

# Cloudflare R2 — API token manages buckets; S3-compatible keys are only returned by get_cloudflare_r2_env.
CLOUDFLARE_API_TOKEN=cloudflare_api_token_here
R2_ACCESS_KEY_ID=r2_access_key_id_here
R2_SECRET_ACCESS_KEY=r2_secret_access_key_here
# App envs returned by get_cloudflare_r2_env / create_cloudflare_r2_bucket:
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET_NAME=your-r2-bucket
# R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_PUBLIC_URL=https://assets.example.com

# Sentry — org auth token from an internal integration; map org/project per environment.
SENTRY_AUTH_TOKEN=sentry_auth_token_here

# PostHog — personal API key for private project/feature-flag APIs.
POSTHOG_PERSONAL_API_KEY=posthog_personal_api_key_here
# App envs returned by get_posthog_project_env / create_posthog_project:
# NEXT_PUBLIC_POSTHOG_KEY=phc_project_token_here
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PROJECT_ID=12345

# Clerk — Secret Key stays server-side; publishable key is mapped per environment.
CLERK_SECRET_KEY=clerk_secret_key_here
# App envs returned by get_clerk_app_env:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_live_here
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Resend — API key from resend.com/api-keys
RESEND_API_KEY=resend_api_key_here

# Twilio — Account SID is mapped per environment; auth token stays in env.
TWILIO_AUTH_TOKEN=twilio_auth_token_here

# Namecheap — enable API access at Profile -> Tools -> API Access (eligibility applies).
# NAMECHEAP_CLIENT_IP must be this machine's CURRENT public IP (curl ifconfig.me)
# and the SAME IP must be whitelisted in API Access. Re-whitelist on error 1011102.
NAMECHEAP_API_USER=your_namecheap_username
NAMECHEAP_API_KEY=namecheap_api_key_here
NAMECHEAP_CLIENT_IP=203.0.113.7
# true targets api.sandbox.namecheap.com (separate signup at sandbox.namecheap.com).
# Recommended until your account is enabled and you are ready to spend real money.
NAMECHEAP_SANDBOX=true
